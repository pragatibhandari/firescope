# Copy to backend/.env and fill in. Never commit the real file.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Build the labelled synthetic demo dataset on first start (1) or not (0)
FIRESCOPE_DEMO=1
# Comma-separated allowed origins for the API (use your frontend URL in production)
FIRESCOPE_CORS=*
# Admin password for sync / upload / delete. ALWAYS set this on a public server.
FIRESCOPE_ADMIN_TOKEN=
